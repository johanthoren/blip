#!/usr/bin/env bash
# imsg (Linux) — thin client for the Mac's read-only iMessage query tool.
#
# iMessage is macOS-only: chat.db lives on the Mac and is TCC-protected. sshd on
# the Mac holds Full Disk Access, so we proxy every query over the multiplexed
# ssh ControlMaster socket (~47ms warm). Backend: <mac>:~/bin/imsg
#
# Usage is identical to the Mac-side tool: recent|from|search|thread|contacts|chats
set -euo pipefail

# The Mac that holds chat.db — an ssh Host alias from ~/.ssh/config.
MAC="${BLIP_MAC_HOST:-mac}"

if ! ssh -o ConnectTimeout=5 "$MAC" true 2>/dev/null; then
  echo "imsg: $MAC unreachable — the iMessage bridge is offline." >&2
  exit 69   # EX_UNAVAILABLE
fi

# `imsg groups` is Linux-side: the Mac tool has no group lookup, so we
# extend the shim rather than fork the Mac-side Python. Emits JSON
# [{chat, name, participants:[handle,...]}] for every group chat (style=43).
if [[ "${1:-}" == "groups" ]]; then
  exec ssh "$MAC" 'PATH=/opt/homebrew/bin:$PATH sqlite3 -json "file:$HOME/Library/Messages/chat.db?mode=ro" \
    "select c.chat_identifier as chat, c.guid as guid, coalesce(c.display_name,\"\") as name, group_concat(h.id, \",\") as participants \
     from chat c left join chat_handle_join j on j.chat_id=c.ROWID left join handle h on h.ROWID=j.handle_id \
     where c.style=43 group by c.ROWID"'
fi

exec ssh "$MAC" "PATH=/opt/homebrew/bin:\$PATH python3 \$HOME/bin/imsg ${*@Q}"
